        ]
      },
      {
        "name": "prometheus",
        "exec": "docker",
        "image": "docker.io/prom/prometheus:v3.13.1",
        "ports": [
          "127.0.0.1:9090:9090"
        ],
        "env": {},
        "volumes": [
          "$(pwd)/support/workshop-prometheus.yml:/etc/prometheus/prometheus.yml:ro,Z"
        ],
        "cmd": [],
        "check": {
          "url": "http://localhost:9090/-/ready",
          "expect": "Prometheus"
