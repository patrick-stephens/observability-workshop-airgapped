[Unit]
Description=Install the offline observability workshop node
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/o11y-installer/complete

[Service]
Type=oneshot
ExecStart=/opt/o11y-installer/install-demo.sh
RemainAfterExit=yes
StandardOutput=append:/var/log/o11y-installer.log
StandardError=append:/var/log/o11y-installer.log
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
